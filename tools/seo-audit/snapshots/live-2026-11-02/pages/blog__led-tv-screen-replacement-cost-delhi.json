        "mainEntity": [
          {
            "@type": "Question",
            "name": "Can a cracked LED TV screen be repaired?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A cracked LED TV screen usually needs panel replacement, but cost and part availability decide whether it is practical."
            }
          },
          {
            "@type": "Question",
            "name": "Is screen replacement cheaper than a new TV?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Not always. For large or older TVs, panel cost can be close to a new TV, so inspection-based guidance is important."
            }
          },
          {
            "@type": "Question",
            "name": "Can sound but no picture mean screen damage?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "It can, but it may also be a backlight, T-Con, power or mainboard issue. Diagnosis is needed before deciding."
            }
          },
          {
            "@type": "Question",
            "name": "Do you give a fixed screen replacement price online?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. GR Solution avoids fake fixed prices because cost depends on model, size, panel condition and part availability."
            }
          },
          {
            "@type": "Question",
            "name": "How do I book inspection in Delhi?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Call, WhatsApp or use the contact form with your TV model, size, symptom and location."
            }
          }
        ]
