      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Can vertical lines on a TV screen be fixed?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Often, yes. Lines caused by the T-Con board or a loose panel ribbon are repairable. Lines caused by physical panel damage need a panel replacement, which is often not economical."
            }
          },
          {
            "@type": "Question",
            "name": "Why did lines appear on my TV suddenly?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Sudden lines without any impact usually point to a failing T-Con board or panel driver. Lines that appeared after the set was moved suggest a loosened ribbon cable."
            }
          },
          {
            "@type": "Question",
            "name": "Are horizontal lines worse than vertical lines?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Not necessarily. Direction depends on how the panel is driven. What matters more is whether the lines change over time, which points to a board, or stay fixed, which points to the panel."
            }
          },
          {
            "@type": "Question",
            "name": "Will lines on my TV get worse?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Board-related lines often spread or multiply as the component degrades. Getting it diagnosed early can keep it a board repair rather than a larger job."
            }
          }
        ]
      }
    ]
