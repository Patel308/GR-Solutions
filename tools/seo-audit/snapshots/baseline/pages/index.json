      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Do you provide home service across Delhi, Noida & NCR?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, GR Solution provides doorstep repair services across Delhi, Noida, Greater Noida, Ghaziabad and nearby NCR areas."
          }
        },
        {
          "@type": "Question",
          "name": "How quickly can a technician visit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In most nearby service areas, we try to arrange same-day or next-day technician visits depending on availability and the repair issue."
          }
        },
        {
          "@type": "Question",
          "name": "Which TV types do you repair?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We repair LED, LCD, OLED/QLED, Plasma, Curved and large-screen televisions from major brands."
          }
        },
        {
          "@type": "Question",
          "name": "Do you repair TV panels and display issues?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we handle panel-related issues, display lines, backlight problems, no display, screen flickering and panel bonding cases where repair is possible."
          }
        },
        {
          "@type": "Question",
          "name": "Do you provide warranty after repair?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Warranty depends on the repair type and parts used. Our team explains the warranty terms clearly before starting the repair."
          }
        },
        {
          "@type": "Question",
          "name": "Can I get an estimate before repair?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, after diagnosis we share the repair estimate clearly so you can approve the work before any paid repair begins."
          }
        },
        {
          "@type": "Question",
          "name": "Do you use genuine parts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We use genuine or high-quality compatible parts depending on availability, device model and customer approval."
          }
        },
        {
          "@type": "Question",
          "name": "How can I book a repair service?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can call directly, send a WhatsApp message, or submit the enquiry form on the website. Our team will contact you for details and scheduling."
          }
        }
      ]
    }
