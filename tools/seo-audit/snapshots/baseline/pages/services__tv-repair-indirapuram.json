            "@type": "Question",
            "name": "My TV stopped when the society generator started. What failed?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Almost always the power supply board. The changeover between mains and generator produces a transient that power boards are most exposed to. The screen is rarely affected."
            }
          },
          {
            "@type": "Question",
            "name": "Can a large TV from Indirapuram go to your workshop?",
            "acceptedAnswer": {
