          {
            "@type": "Question",
            "name": "Can LED TV panel lines be repaired?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Sometimes, depending on whether the cause is panel-level damage, T-Con, board behavior or connection symptoms."
            }
          },
          {
            "@type": "Question",
            "name": "Is panel bonding always possible?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. Panel bonding depends on the panel type, damage level and available repair feasibility."
            }
          },
          {
            "@type": "Question",
            "name": "Is a black screen always a panel issue?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. A black screen can be backlight, power, T-Con, mainboard or panel related."
            }
          },
          {
            "@type": "Question",
            "name": "Should I repair or replace the TV?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Compare fault type, TV age, screen condition, part availability and estimate before deciding."
            }
          },
          {
            "@type": "Question",
            "name": "Can GR Solution inspect at home?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Many checks can start at home. If safer workshop handling is needed, the technician explains why."
            }
          }
