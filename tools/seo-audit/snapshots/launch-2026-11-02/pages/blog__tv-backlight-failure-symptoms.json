        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How do I know if my TV backlight is broken?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Shine a phone torch at the screen at a sharp angle while the TV is on. If you can faintly see the picture, the panel is working and the backlight has failed."
            }
          },
          {
            "@type": "Question",
            "name": "How much does TV backlight repair cost?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "In the Delhi NCR market, roughly ₹3,000–₹8,000 for 32”–43” sets, ₹5,500–₹12,000 for 44”–55” sets, and ₹8,500–₹18,000 for larger sets."
            }
          },
          {
            "@type": "Question",
            "name": "Is TV backlight repair worth it?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Usually, yes. The backlight costs a fraction of the panel, and the repair keeps the most valuable part of the TV in service."
            }
          },
          {
            "@type": "Question",
            "name": "Do OLED TVs have backlight problems?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. OLED pixels produce their own light, so there is no backlight to fail. A dark OLED screen points to a board, power or panel fault instead."
            }
          }
        ]
      }
