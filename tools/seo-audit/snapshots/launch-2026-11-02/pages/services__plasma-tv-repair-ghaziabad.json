        "mainEntity": [
          {
            "@type": "Question",
            "name": "Can plasma backlight strips be replaced to restore the picture?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A plasma panel produces its image without an LED strip backlight. A blank or unstable picture requires plasma-specific checks, including power, sustain and control functions. Advice intended for an LED set can be misleading here."
            }
          },
          {
            "@type": "Question",
            "name": "Does clicking mean the plasma power board is definitely bad?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. Protection behaviour can be triggered by a fault elsewhere, and relay sounds are only a clue. Testing must establish the failed section before a replacement board is justified."
            }
          },
          {
            "@type": "Question",
            "name": "Is every old plasma worth collecting for repair?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. Share the model, condition and fault history first. If compatible parts are unavailable or the likely expense is impractical, discussing replacement may avoid paying to move a heavy set unnecessarily."
            }
          }
        ]
      }
